[Unit]
Description=Top Fitness programación de recordatorios
After=mariadb.service

[Service]
Type=oneshot
User=www-data
EnvironmentFile=/etc/topfitness-web/notify.env
ExecStart=/usr/bin/php /opt/topfitness-web/cli/notify_tick.php
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
